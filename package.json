{
  "name": "may-mac-fashion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --port 5173\" \"wrangler dev --port 8787\"",
    "dev:web": "vite --port 5173",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "wrangler dev --local",
    "db:local": "wrangler d1 migrations apply may-mac-store --local",
    "db:remote": "wrangler d1 migrations apply may-mac-store --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.160.0"
  }
}
